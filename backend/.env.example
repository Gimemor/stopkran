# ============================================================
#  Шаблон: cp .env.example .env
#  Секреты живут только в .env (не коммитится).
# ============================================================

# --- ВАРИАНТ A: локальная Postgres из docker-compose (по умолчанию) ---
DATABASE_URL=postgresql+asyncpg://stopkran:stopkran@db:5432/stopkran
DB_SSL=false

# --- ВАРИАНТ B: Supabase (прод). Dashboard → Connect → Transaction pooler ---
# Пулер отдаёт IPv4; прямой хост db.<ref>.supabase.co — только IPv6.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<ПАРОЛЬ>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_SSL=true

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400
# true только для локальной отладки; в проде false
DEV_ALLOW_UNVERIFIED=true
# HTTPS-адрес Mini App для кнопки в боте
MINI_APP_URL=
# Папка с index.html для отдачи на GET /mini/ ("" = выключено)
FRONTEND_DIR=
# Секрет для X-Telegram-Bot-Api-Secret-Token (придумайте случайный)
TELEGRAM_WEBHOOK_SECRET=

# --- Приложение ---
ENVIRONMENT=dev
PORT=8000
FREE_LIMIT=0
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:5500
